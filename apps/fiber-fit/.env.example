# Local: leave DATABASE_URL commented to use the file DB in .data/fiberfit.
# Production (Vercel): set DATABASE_URL to the Supabase *transaction pooler* URI (port 6543).
# DATABASE_URL=postgresql://postgres.XXXX:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

SESSION_SECRET=dev-only-change-me-in-production
NEXT_PUBLIC_IS_MAINNET=false
